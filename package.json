{
  "name": "@forjio/depllo",
  "version": "0.3.0",
  "description": "Official Node/TypeScript SDK for Depllo \u2014 GitLab-CI-style CI/CD for GitHub repos.",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "depllo",
    "ci",
    "cd",
    "forjio",
    "pipelines"
  ],
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hachimi-cat/depllo-js.git"
  },
  "bugs": {
    "url": "https://github.com/hachimi-cat/depllo-js/issues"
  },
  "homepage": "https://github.com/hachimi-cat/depllo-js#readme"
}
